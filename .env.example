# 站点正式域名：sitemap 与文章分享链接用，结尾不带 /
VITE_AYO_SITE_URL=https://docs.ayostack.cn:441
# 「编辑此页」地址模板，:path 由 VitePress 替换成文件路径
VITE_AYO_EDIT_LINK_PATTERN=https://gitea.luckyxm.cn:441/ayostack/ayo-docs/_edit/main/docs/:path
# 代码托管平台名：拼出「在 X 上编辑此页」文案（Gitea / GitHub / GitLab）
VITE_AYO_EDIT_LINK_TYPE=Gitea
# 文章固定解锁码（当前为临时方案，见 theme/utils/article-lock.ts）
VITE_AYO_LOCK_UNLOCK_CODE=ayostack
# 部署子路径：根路径部署留 /，GitHub Pages 项目站点填 /<仓库名>/
VITE_AYO_BASE=/
